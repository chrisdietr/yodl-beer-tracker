# Beer Webhook API URL
# This is the URL that provides the beer consumption data
VITE_BEER_WEBHOOK_URL=https://your-webhook-url.com/api/data

# Enable Mock Data Mode (for development/testing)
# Set to 'true' to use the mock service instead of the real webhook
# This is useful for local development without needing a real data source
VITE_USE_MOCK_DATA=false
